// wrangler.jsonc — Cloudflare Workers deployment: static site from ./dist + /api proxy (worker/index.js).
// Cloudflare build settings:  Build command: npm run build   Deploy command: npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kscwc-frontend",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Backend address (public, not a secret). PROXY_SHARED_SECRET stays in the Cloudflare dashboard.
  "vars": {
    "API_ORIGIN": "https://kscwc-backend-production.up.railway.app"
  },
  "keep_vars": true
}
