# _headers — security response headers for static hosting (Netlify / Cloudflare Pages honour this file).
# For nginx/Apache/other hosts, set the same headers in the server config (see docs/FRONTEND.md).
# The CSP allows: our own origin, Razorpay Checkout, YouTube embeds, and data: images (FID preview).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://checkout.razorpay.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.razorpay.com; font-src 'self' data:; connect-src 'self' https://*.razorpay.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://*.razorpay.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
